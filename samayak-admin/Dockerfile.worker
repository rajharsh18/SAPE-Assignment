FROM node:22-alpine
WORKDIR /app

# poppler-utils: pdftoppm renders each PDF page to PNG for the vision LLM.
# Tesseract is no longer needed — Groq's vision model reads pages directly.
RUN apk add --no-cache poppler-utils

COPY package*.json ./
RUN npm install
COPY . .
RUN npx prisma generate
RUN npx tsc --project tsconfig.worker.json

CMD ["node", "dist/workers/index.js"]
